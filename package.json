{
  "name": "studycore",
  "version": "0.1.0",
  "description": "Entorno personal de aprendizaje: Obsidian como conocimiento, Claude Code como motor.",
  "main": "dist-electron/electron/main/main.js",
  "private": true,
  "type": "commonjs",
  "author": "RonnyGG",
  "license": "UNLICENSED",
  "productName": "StudyCore",
  "scripts": {
    "dev": "npm run build:electron && node scripts/dev.cjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:electron && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:real": "vitest run -c vitest.real.config.mts"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "unpdf": "2.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "electron": "45.0.0",
    "lucide-react": "1.61.0",
    "postcss": "8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
